@{
    ViewData["Title"] = "Success Stories";
}

<div class="container mt-5">
    <h2>Success Stories</h2>
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Sarah's Journey</h5>
            <p class="card-text">Sarah, a 5-year-old girl with speech delays, made remarkable progress through our speech therapy program. She is now able to communicate effectively with her peers and family.</p>
        </div>
    </div>
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Tom's Transformation</h5>
            <p class="card-text">Tom, diagnosed with ADHD, benefited greatly from our behavioral therapy sessions. He has developed better self-control and improved his social interactions.</p>
        </div>
    </div>
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Emma's Improvement</h5>
            <p class="card-text">Emma, who struggled with fine motor skills, showed significant improvement through our occupational therapy program. She can now perform daily tasks independently.</p>
        </div>
    </div>
</div>
