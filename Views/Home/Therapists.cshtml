@{
    ViewData["Title"] = "Meet Our Therapists";
}

<style>
    .card-img-top {
        width: 100%;
        height: 700px; /* Adjust the height as needed */
        object-fit: cover; /* Ensures the image covers the entire area without distortion */
    }
</style>

<div class="container">
    <h2 class="mb-4">Meet Our Therapists</h2>
    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card shadow-lg">
                <img src="/Upload/Images/88745491-9f49-4334-9086-7de62c8d6ee4_Therapy1.jpg" class="card-img-top" alt="Dr. Jane Smith">
                <div class="card-body">
                    <h5 class="card-title">Dr. Jane Smith</h5>
                    <p class="card-text">Dr. Jane Smith is a licensed speech therapist with over 10 years of experience helping children improve their communication skills.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card shadow-lg">
                <img src="/Upload/Images/aafa92bd-87d2-49ab-9a39-e491790e19af_Therapy2.png" class="card-img-top" alt="Mr. John Doe">
                <div class="card-body">
                    <h5 class="card-title">Mr. John Doe</h5>
                    <p class="card-text">Mr. John Doe is a certified occupational therapist who specializes in sensory integration and fine motor skill development.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card shadow-lg">
                <img src="/Upload/Images/c569a54a-b835-45ad-8a33-11a70bcb7102_ba202b02167d64a5da7de1f32892cbbb.jpg" class="card-img-top" alt="Ms. Emily Davis">
                <div class="card-body">
                    <h5 class="card-title">Ms. Emily Davis</h5>
                    <p class="card-text">Ms. Emily Davis is a physical therapist with extensive experience in pediatric rehabilitation and motor skills enhancement.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card shadow-lg">
                <img src="/Upload/Images/ab43e166-3d48-4875-83fb-a44e63d5db83_Picture1.jpg" class="card-img-top" alt="Dr. Michael Lee">
                <div class="card-body">
                    <h5 class="card-title">Dr. Michael Lee</h5>
                    <p class="card-text">Dr. Michael Lee is a behavioral therapist who focuses on developing positive behaviors and social skills in children.</p>
                </div>
            </div>
        </div>
    </div>
</div>
