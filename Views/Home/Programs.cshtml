@{
    ViewData["Title"] = "Our Programs";
}

<div class="container mt-5">
    <h2>Our Programs</h2>
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Speech Therapy</h5>
            <p class="card-text">Our speech therapy program helps children improve their communication skills through personalized exercises and activities.</p>
        </div>
    </div>
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Occupational Therapy</h5>
            <p class="card-text">This program focuses on helping children develop the skills they need for daily living and academic success.</p>
        </div>
    </div>
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Physical Therapy</h5>
            <p class="card-text">Our physical therapy program is designed to improve the motor skills and physical abilities of children through targeted exercises.</p>
        </div>
    </div>
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Behavioral Therapy</h5>
            <p class="card-text">This program helps children develop positive behaviors and social skills through structured interventions and support.</p>
        </div>
    </div>
</div>
