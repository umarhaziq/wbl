@model IEnumerable<wbl.Models.Programs>

@{
    ViewData["Title"] = "Programs";
}

<div class="container mt-4">
    <h1>Programs</h1>

    <p>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Create New</a>
    </p>

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body">
                    <h2>Weekday Programs</h2>
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Description</th>
                                <th>Price</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Where(p => p.Program_Category == "Weekday"))
                            {
                                <tr>
                                    <td>@Html.DisplayFor(modelItem => item.ProgramName)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Description)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Price)</td>
                                    <td>
                                        <a asp-action="Edit" asp-route-id="@item.ProgramId" class="btn btn-warning"><i class="bi bi-pencil-square"></i></a>
                                        <a asp-action="Details" asp-route-id="@item.ProgramId" class="btn btn-info"><i class="bi bi-card-list"></i></a>
                                        <a asp-action="Delete" asp-route-id="@item.ProgramId" class="btn btn-danger"><i class="bi bi-trash3"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body">
                    <h2>Weekend Programs</h2>
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Description</th>
                                <th>Price</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Where(p => p.Program_Category == "Weekend"))
                            {
                                <tr>
                                    <td>@Html.DisplayFor(modelItem => item.ProgramName)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Description)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Price)</td>
                                    <td>
                                        <a asp-action="Edit" asp-route-id="@item.ProgramId" class="btn btn-warning"><i class="bi bi-pencil-square"></i></a>
                                        <a asp-action="Details" asp-route-id="@item.ProgramId" class="btn btn-info"><i class="bi bi-card-list"></i></a>
                                        <a asp-action="Delete" asp-route-id="@item.ProgramId" class="btn btn-danger"><i class="bi bi-trash3"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
