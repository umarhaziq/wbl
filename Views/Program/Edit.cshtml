@model wbl.Models.Programs

@{
    ViewData["Title"] = "Edit";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body">
                    <h1 class="card-title">Edit Program</h1>
                    <hr />

                    <form asp-action="Edit" asp-controller="Program">
                        <div asp-validation-summary="All" class="text-danger"></div>

                        <input type="hidden" asp-for="ProgramId" />
                        <div class="form-group">
                            <label asp-for="ProgramName" class="control-label">Name</label>
                            <input asp-for="ProgramName" class="form-control" />
                            <span asp-validation-for="ProgramName" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Description" class="control-label">Description</label>
                            <input asp-for="Description" class="form-control" />
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="form-group mt-3">
                            <button type="submit" value="Save" class="btn btn-primary">Save</button>
                            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
