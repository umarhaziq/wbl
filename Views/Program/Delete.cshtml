@model wbl.Models.Programs

@{
    ViewData["Title"] = "Delete";
}

<div class="container mt-4">
    <h1>Delete</h1>

    <div class="card shadow">
        <div class="card-body">
            <h3 class="card-title">Are you sure you want to delete this?</h3>
            <hr />

            <dl class="row">
                <dt class="col-sm-2">Name</dt>
                <dd class="col-sm-10">@Html.DisplayFor(model => model.ProgramName)</dd>

                <dt class="col-sm-2">Description</dt>
                <dd class="col-sm-10">@Html.DisplayFor(model => model.Description)</dd>
            </dl>

            <form asp-action="Delete">
                <input type="hidden" asp-for="ProgramId" />
                <input type="submit" value="Delete" class="btn btn-danger" />
                <a asp-action="Index" class="btn btn-primary">Back to List</a>
            </form>
        </div>
    </div>
</div>
