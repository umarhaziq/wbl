@model wbl.Models.ViewModels.ProgramDetailsViewModel

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header">
            <h4 class="card-title">Program Details</h4>
            <hr />

            <dl class="row">
                <dt class="col-sm-2">Name</dt>
                <dd class="col-sm-10">@Html.DisplayFor(model => model.Program.ProgramName)</dd>

                <dt class="col-sm-2">Description</dt>
                <dd class="col-sm-10">@Html.DisplayFor(model => model.Program.Description)</dd>

                <dt class="col-sm-2">Category</dt>
                <dd class="col-sm-10">@Html.DisplayFor(model => model.Program.Program_Category)</dd>

                <dt class="col-sm-2">Price</dt>
                <dd class="col-sm-10">@Html.DisplayFor(model => model.Program.Price)</dd>
            </dl>
        </div>
        <div class="card-body">
            <h4 class="card-title">Students</h4>
            @if (Model.Program.Program_Category == "Weekday")
            {
                <table class="table table-responsive">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Birthplace</th>
                            <th>Date of Birth</th>
                            <th>Gender</th>
                            <th>Nationality</th>
                            <th>Race</th>
                            <th>Religion</th>
                            <th>Address</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var student in Model.Students)
                        {
                            <tr>
                                <td>@Html.DisplayFor(model => student.Child_Name)</td>
                                <td>@Html.DisplayFor(model => student.Child_Birthplace)</td>
                                <td>@Html.DisplayFor(model => student.Child_DOB)</td>
                                <td>@Html.DisplayFor(model => student.Child_Gender)</td>
                                <td>@Html.DisplayFor(model => student.Child_Nationality)</td>
                                <td>@Html.DisplayFor(model => student.Child_Race)</td>
                                <td>@Html.DisplayFor(model => student.Child_Religion)</td>
                                <td>@Html.DisplayFor(model => student.Child_Address)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else if (Model.Program.Program_Category == "Weekend")
            {
                <table class="table table-responsive">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Birthplace</th>
                            <th>Date of Birth</th>
                            <th>Gender</th>
                            <th>Nationality</th>
                            <th>Race</th>
                            <th>Religion</th>
                            <th>Address</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var student in Model.Students)
                        {
                            <tr>
                                <td>@Html.DisplayFor(model => student.Child_Name)</td>
                                <td>@Html.DisplayFor(model => student.Child_Birthplace)</td>
                                <td>@Html.DisplayFor(model => student.Child_DOB)</td>
                                <td>@Html.DisplayFor(model => student.Child_Gender)</td>
                                <td>@Html.DisplayFor(model => student.Child_Nationality)</td>
                                <td>@Html.DisplayFor(model => student.Child_Race)</td>
                                <td>@Html.DisplayFor(model => student.Child_Religion)</td>
                                <td>@Html.DisplayFor(model => student.Child_Address)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="card-footer">
            <a asp-action="Edit" asp-route-id="@Model.Program.ProgramId" class="btn btn-warning">Edit</a>
            <a asp-action="Index" class="btn btn-primary">Back to List</a>
        </div>
    </div>
</div>
