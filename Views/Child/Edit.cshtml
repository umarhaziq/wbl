@model wbl.Models.ViewModels.ChildViewModel

@{
    ViewData["Title"] = "Edit Child";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body">
                    <h1 class="card-title">Edit Child</h1>
                    <hr />
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Child_IC" />

                        <div class="form-group">
                            <label asp-for="Child_Name">Child Name</label>
                            <input asp-for="Child_Name" class="form-control" />
                            <span asp-validation-for="Child_Name" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Child_Birthplace">Birthplace</label>
                            <input asp-for="Child_Birthplace" class="form-control" />
                            <span asp-validation-for="Child_Birthplace" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Child_DOB">Date Of Birth</label>
                            <input asp-for="Child_DOB" class="form-control" />
                            <span asp-validation-for="Child_DOB" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Child_Gender">Gender</label>
                            <input asp-for="Child_Gender" class="form-control" />
                            <span asp-validation-for="Child_Gender" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Child_Nationality">Nationality</label>
                            <input asp-for="Child_Nationality" class="form-control" />
                            <span asp-validation-for="Child_Nationality" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Child_Race">Race</label>
                            <input asp-for="Child_Race" class="form-control" />
                            <span asp-validation-for="Child_Race" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Child_Religion">Religion</label>
                            <input asp-for="Child_Religion" class="form-control" />
                            <span asp-validation-for="Child_Religion" class="text-danger"></span>
                        </div>


                        <div class="form-group">
                            <label for="Program_Category">Category</label>
                            <select asp-for="Program_Category" class="form-control" id="Program_Category">
                                <option value="">Select Category</option>
                                <option value="Weekday">Weekday</option>
                                <option value="Weekend">Weekend</option>
                            </select>
                            <span asp-validation-for="Program_Category" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="ProgramId">Program</label>
                            <select asp-for="ProgramId" asp-items="@Model.ProgramsList" class="form-control">
                                <option value="">Select Program</option>
                            </select>
                            <span asp-validation-for="ProgramId" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Child_Address">Address</label>
                            <input asp-for="Child_Address" class="form-control" />
                            <span asp-validation-for="Child_Address" class="text-danger"></span>
                        </div>

                        <input asp-for="FatherIc" class="form-control" type="hidden" />
                        

                        <br />
                        <button type="submit" class="btn btn-primary">Save</button> | 
                        <button asp-action="Index" class="btn btn-secondary">Back to List</button>
                    </form>
                    
                </div>
            </div>
        </div>
    </div>
</div>