@model wbl.Models.ViewModels.ChildViewModel

@{
    ViewData["Title"] = "Create Child";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@if (TempData["Notification"] != null)
{
    <div class="alert alert-warning">
        @TempData["Notification"]
    </div>
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body">
                    <h1 class="card-title">Child Registration</h1>
                    <hr />

                    <form asp-action="Create" method="post">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Child_IC" class="control-label"></label>
                                    <input asp-for="Child_IC" class="form-control" />
                                    <span asp-validation-for="Child_IC" class="text-danger"></span>
                                </div>


                                <div class="form-group">
                                    <label asp-for="Child_Name"></label>
                                    <input asp-for="Child_Name" class="form-control" />
                                    <span asp-validation-for="Child_Name" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="Child_Birthplace"></label>
                                    <input asp-for="Child_Birthplace" class="form-control" />
                                    <span asp-validation-for="Child_Birthplace" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="Child_DOB"></label>
                                    <input asp-for="Child_DOB" class="form-control" type="date" />
                                    <span asp-validation-for="Child_DOB" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="Child_Gender">Gender</label>
                                    <select asp-for="Child_Gender" class="form-control" id="Child_Gender">
                                        <option value="">Select Gender</option>
                                        <option value="Male">Male</option>
                                        <option value="Female">Female</option>

                                        <!-- Add more options as needed -->
                                    </select>
                                    <span asp-validation-for="Child_Gender" class="text-danger"></span>
                                </div>


                                <div class="form-group">
                                    <label asp-for="Child_Nationality"></label>
                                    <input asp-for="Child_Nationality" class="form-control" />
                                    <span asp-validation-for="Child_Nationality" class="text-danger"></span>
                                </div>
                                <div class="form-group">
                                    <label for="Child_Race">Race</label>
                                    <select asp-for="Child_Race" class="form-control" id="Child_Race">
                                        <option value="">Select Race</option>
                                        <option value="Malay">Malay</option>
                                        <option value="Indian">Indian</option>
                                        <option value="Chinese">Chinese</option>
                                        <!-- Add more options as needed -->
                                    </select>
                                    <span asp-validation-for="Child_Race" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="Child_Religion"></label>
                                    <input asp-for="Child_Religion" class="form-control" />
                                    <span asp-validation-for="Child_Religion" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="form-group">
                                <label asp-for="Child_Address"></label>
                                <textarea asp-for="Child_Address" class="form-control" rows="4"></textarea>
                                <span asp-validation-for="Child_Address" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label for="Program_Category">Category</label>
                                <select asp-for="Program_Category" class="form-control" id="Program_Category">
                                    <option value="">Select Category</option>
                                    <option value="Weekday">Weekday</option>
                                    <option value="Weekend">Weekend</option>
                                </select>
                                <span asp-validation-for="Program_Category" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="ProgramId"></label>
                                <select asp-for="ProgramId" asp-items="@Model.ProgramsList" class="form-control">
                                    <option value="">Select Program</option>
                                </select>
                                <span asp-validation-for="ProgramId" class="text-danger"></span>
                            </div>

                            <input asp-for="FatherIc" type="hidden" />

                        </div>

                        <div class="text-center mt-4">
                            <button type="submit" class="btn btn-primary mx-2">Create</button>
                            <a asp-action="Index" class="btn btn-secondary mx-2">View Child List</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#Program_Category').change(function () {
                var selectedCategory = $(this).val();
                $.ajax({
                    url: '@Url.Action("GetProgramsByCategory", "Child")',
                    type: 'GET',
                    data: { category: selectedCategory },
                    success: function (data) {
                        $('#ProgramId').empty(); // Clear current options
                        $.each(data, function (index, item) {
                            $('#ProgramId').append($('<option>').text(item.text).attr('value', item.value));
                        });
                    }
                });
            });
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

