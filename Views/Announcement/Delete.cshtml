@model wbl.Models.Announcement

@{
    ViewData["Title"] = "Delete Announcement";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2 class="text-danger">@ViewData["Title"]</h2>

    <h3 class="text-warning">Are you sure you want to delete this announcement?</h3>

    <div class="card mt-4">
        <div class="card-header">
            <h4>@Model.Title</h4>
        </div>
        <div class="card-body">
            <p><strong>Content:</strong> @Model.Content</p>

            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <div class="text-center">
                    <img src="@Url.Content(Model.ImagePath)" alt="Announcement Image" class="img-thumbnail" style="max-width: 400px;">
                </div>
            }
        </div>
    </div>

    <form asp-action="Delete" asp-route-id="@Model.Id" class="mt-4">
        <input type="hidden" asp-for="Id" />
        <div class="form-group">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
