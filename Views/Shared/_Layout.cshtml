@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - wbl</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/wbl.styles.css" asp-append-version="true" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            font-family: 'Arial', sans-serif;
            background-color: white;
        }

        .sidebar {
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            width: 250px;
            z-index: 100;
            padding: 48px 0 0;
            background-color: white;
            border-right: 1px solid #ddd;
            transition: all 0.3s ease-in-out;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

            .sidebar .nav-link {
                color: #333;
            }

                .sidebar .nav-link:hover {
                    background-color: #f8f9fa;
                }

                .sidebar .nav-link.active {
                    background-color: #007bff;
                    color: white;
                }

            .sidebar .nav-item {
                margin-bottom: 10px;
            }

            .sidebar .card {
                border: 1px solid #ddd;
                border-radius: 5px;
            }

                .sidebar .card .card-body {
                    padding: 10px 15px;
                }

                .sidebar .card .dropdown-menu {
                    background-color: white;
                    border: 1px solid #ddd;
                }

                .sidebar .card .dropdown-item {
                    color: #333;
                }

                    .sidebar .card .dropdown-item:hover {
                        background-color: #f8f9fa;
                    }

            .sidebar .login-partial {
                background-color: #f1f1f1;
                padding: 10px;
                border-top: 1px solid #ddd;
            }

        .sidebar-toggle {
            margin-left: 250px;
            transition: all 0.3s ease-in-out;
        }

        .sidebar.hidden {
            width: 0;
            padding: 0;
            overflow: hidden;
        }

        .sidebar-toggle.shifted {
            margin-left: 0;
        }

        .sidebar-header {
            text-align: center;
            font-weight: bold;
        }

            .sidebar-header .navbar-brand img {
                height: 90px; /* Adjusted height for the logo */
                width: auto;
                display: block; /* Ensures the image behaves as a block element */
            }

    </style>
</head>
<body>
    <div class="d-flex">
        <div class="sidebar bg-light" id="sidebar">
            <div>
                <header class="sidebar-header">
                    <nav class="navbar">
                        <div class="container-fluid text-center d-flex justify-content-center align-items-center">
                            <!-- Added d-flex, justify-content-center, and align-items-center classes to center content -->
                            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                                <img src="~/Upload/Images/0c3985df-3926-4e08-9d96-c7ec89d9d209_autism.jpg" alt="Autism Therapy Logo" style="height: 90px; width: auto;">
                            </a>
                        </div>
                    </nav>
                </header>



                <ul class="nav flex-column">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        var roles = UserManager.GetRolesAsync(await UserManager.GetUserAsync(User)).Result;
                        @if (roles.Contains("Admin"))
                        {
                            <li class="nav-item">
                                <div class="card">
                                    <div class="card-body">
                                        <a class="nav-link dropdown-toggle text-dark" href="#" id="createDropdown" role="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                            <i class="bi bi-plus-circle"></i> Create
                                        </a>
                                        <div class="dropdown-menu" aria-labelledby="createDropdown">
                                            <a class="dropdown-item" asp-area="" asp-controller="Admin" asp-action="AddAdmin">Admin</a>
                                            <a class="dropdown-item" asp-area="" asp-controller="Therapist" asp-action="AddTherapist">Therapist</a>
                                            <a class="dropdown-item" asp-area="" asp-controller="Therapist" asp-action="Create">Customer Service</a>
                                        </div>
                                    </div>
                                </div>
                            </li>
                            <li class="nav-item">
                                <div class="card">
                                    <div class="card-body">
                                        <a class="nav-link dropdown-toggle text-dark" href="#" id="listDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-list-ul"></i> List
                                        </a>
                                        <div class="dropdown-menu" aria-labelledby="listDropdown">
                                            <a class="dropdown-item" asp-area="" asp-controller="Admin" asp-action="listAdmin">Admin</a>
                                            <a class="dropdown-item" asp-controller="Therapist" asp-action="ListTherapist">Therapist</a>
                                            <a class="dropdown-item" asp-controller="CustomerService" asp-action="Index">Customer Service</a>
                                        </div>
                                    </div>
                                </div>
                            </li>
                        }
                        else if (roles.Contains("Therapist"))
                        {
                            <li class="nav-item">
                                <div class="card">
                                    <div class="card-body">
                                        <a class="nav-link text-dark" asp-controller="Therapist" asp-action="SetAvailability"><i class="bi bi-calendar-check"></i> Availability</a>
                                    </div>
                                </div>
                            </li>
                            <li class="nav-item">
                                <div class="card">
                                    <div class="card-body">
                                        <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy"><i class="bi bi-shield-lock"></i> Privacy</a>
                                    </div>
                                </div>
                            </li>
                        }
                        else if (roles.Contains("CustomerService"))
                        {
                            <li class="nav-item">
                                <div class="card">
                                    <div class="card-body">
                                        <a class="nav-link text-dark" asp-area="" asp-controller="Therapist" asp-action="SetAvailability"><i class="bi bi-person-lines-fill"></i> CS</a>
                                    </div>
                                </div>
                            </li>
                            <li class="nav-item">
                                <div class="card">
                                    <div class="card-body">
                                        <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy"><i class="bi bi-shield-lock"></i> Privacy</a>
                                    </div>
                                </div>
                            </li>
                        }
                        else if (roles.Contains("Parent"))
                        {
                            <!-- Add Parent specific links here if needed -->
                        }
                    }
                    else
                    {
                        <li class="nav-item">
                            <div class="card">
                                <div class="card-body">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i> Home</a>
                                </div>
                            </div>
                        </li>
                        <li class="nav-item">
                            <div class="card">
                                <div class="card-body">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy"><i class="bi bi-shield-lock"></i> Privacy</a>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            </div>

        </div>

        <div class="flex-grow-1 sidebar-toggle" id="content">
            <header>
                <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
                    <div class="container-fluid">
                        <button class="btn btn-warning " id="sidebarToggle"><i class="bi bi-list"></i></button>
                        <div class="login-partial">
                            <partial name="_LoginPartial" />
                        </div>
                    </div>
                </nav>
            </header>

            <div class="container-fluid">
                <!-- Ensure this container-fluid wraps the main content area -->
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>

            <footer class="border-top footer text-muted">
                <div class="container">
                    &copy; 2024 - wbl - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        document.getElementById('sidebarToggle').addEventListener('click', function () {
            document.getElementById('sidebar').classList.toggle('hidden');
            document.getElementById('content').classList.toggle('shifted');
        });
    </script>
</body>
</html>