@model List<wbl.Models.CustomerService>

@{
    ViewData["Title"] = "List of Therapists";
    var numberOfTherapists = ViewBag.numberOfTherapists;
}

<h1 class="text-center">List of Customer Services</h1>

<div class="container mt-4">
    <p>
        <a asp-action="Create" asp-controller="CustomerService" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Create New</a>
    </p>

    <div class="card shadow">
        <div class="card-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone Number</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.Name)</td>
                            <td>@Html.DisplayFor(modelItem => item.Email)</td>
                            <td>@Html.DisplayFor(modelItem => item.Phone)</td>
                            <td>@Html.DisplayFor(modelItem => item.Status)</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.CustomerServiceId" class="btn btn-info mx-2"><i class="bi bi-pencil-square"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.CustomerServiceId" class="btn btn-danger mx-2"><i class="bi bi-card-list"></i></a>
                                <a asp-action="ChangeStatus" asp-route-id="@item.CustomerServiceId" class="btn btn-warning  mx-2">Toggle Status</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>