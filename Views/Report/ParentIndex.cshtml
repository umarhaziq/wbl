@using wbl.Utilities
@model PaginatedList<wbl.Models.Report>

@{
    ViewData["Title"] = "Reports";
}

<h1 class="text-center">Reports</h1>

<div class="container mt-4">

    <form asp-action="Index" method="get" class="mb-3">
        <div class="input-group">
            <input type="text" name="searchString" class="form-control" placeholder="Find by title" value="@ViewData["CurrentFilter"]" />
            <div class="input-group-append">
                <button class="btn btn-success" type="submit">Search</button>
                <a asp-action="Index" class="btn btn-danger">Reset</a>
            </div>
        </div>
    </form>

    <div class="card shadow">
        <div class="card-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model[0].Title)</th>
                        <th>@Html.DisplayNameFor(model => model[0].Session.Child.Child_Name)</th>
                        <th>@Html.DisplayNameFor(model => model[0].Date)</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.Title)</td>
                            <td>@Html.DisplayFor(modelItem => item.Session.Child.Child_Name)</td>
                            <td>@Html.DisplayFor(modelItem => item.Date)</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.ReportId" class="btn btn-info">Edit</a>
                                <a asp-action="Details" asp-route-id="@item.ReportId" class="btn btn-primary">Details</a>
                                <a asp-action="Delete" asp-route-id="@item.ReportId" class="btn btn-danger">Delete</a>
                                <a asp-action="DownloadPdf" asp-route-id="@item.ReportId" class="btn btn-warning">Download PDF</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                @if (Model.HasPreviousPage)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageIndex - 1)">Previous</a>
                    </li>
                }
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@i">@i</a>
                    </li>
                }
                @if (Model.HasNextPage)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageIndex + 1)">Next</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>
