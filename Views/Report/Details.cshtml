@model wbl.Models.Report
@using wbl.Utilities

@{
    ViewData["Title"] = "Details";
}

<h1 class="text-center">Details</h1>

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Title)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Title)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Session.Child.Child_Name)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Session.Child.Child_Name)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Content)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Content)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Date)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Date)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.ReportType)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.ReportType)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Session.Therapist.TherapistId)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Session.Therapist.TherapistId)
                </dd>
            </dl>
        </div>
        <div class="card-footer">
            <a asp-action="Edit" asp-route-id="@Model.ReportId" class="btn btn-info"><i class="bi bi-pencil"></i> Edit</a>
            <a asp-action="DownloadPdf" asp-route-id="@Model.ReportId" class="btn btn-warning"><i class="bi bi-download"></i> Download PDF</a>
            <!-- Delete Confirmation Popup -->
            <button class="btn btn-danger" data-toggle="modal" data-target="#deleteModal-@Model.ReportId">
                <i class="bi bi-trash"></i> Delete
            </button>

            <div class="modal fade" id="deleteModal-@Model.ReportId" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel" aria-hidden="true">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="deleteModalLabel">Delete Confirmation</h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body">
                            Are you sure you want to delete this report?
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                            <a asp-action="DeleteConfirmed" asp-route-id="@Model.ReportId" class="btn btn-danger">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left-circle"></i> Back to List</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Ensure Bootstrap and jQuery are correctly included
        $(document).ready(function () {
            // You can remove this prevent default if you want the default behavior
            $('.btn-danger').click(function (event) {
                event.preventDefault();
            });
        });
    </script>
}
