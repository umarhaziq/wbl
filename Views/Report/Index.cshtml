@using wbl.Utilities
@model PaginatedList<wbl.Models.Report>

@{
    ViewData["Title"] = "Reports";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/wbl.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
    <style>
        /* Custom styles for the search form */
        .form-control {
            width: 100%;
        }

        .col-md-8 {
            padding-right: 0;
        }

        .col-md-4 {
            display: flex;
            justify-content: flex-start;
        }

        .btn {
            margin-left: 10px;
        }
    </style>
</head>

<body>
<h1 class="text-center">Reports</h1>

<div class="container mt-4">

    <p>
        <a href="@Url.Action("Create")" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Create New</a>
    </p>

    <form asp-action="Index" method="get" class="mb-3">
        <div class="input-group">
            <div class="col-md-8">
                <input type="text" name="searchString" class="form-control" placeholder="Find by title" value="@ViewData["CurrentFilter"]" />
            </div>
            <div class="col-md-4 d-flex">
                <button class="btn btn-success ml-2" type="submit"><i class="bi bi-search"></i> Search</button>
                <a asp-action="Index" class="btn btn-danger ml-2">Reset</a>
            </div>
        </div>
    </form>


    <div class="card shadow">
        <div class="card-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model[0].Title)</th>
                        <th>@Html.DisplayNameFor(model => model[0].Session.Child.Child_Name)</th>
                        <th>@Html.DisplayNameFor(model => model[0].Date)</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.Title)</td>
                            <td>@Html.DisplayFor(modelItem => item.Session.Child.Child_Name)</td>
                            <td>@Html.DisplayFor(modelItem => item.Date)</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.ReportId" class="btn btn-primary">
                                    Details  <i class="bi bi-arrow-right-circle"></i>
                                </a>

                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                @if (Model.HasPreviousPage)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageIndex - 1)">Previous</a>
                    </li>
                }
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@i">@i</a>
                    </li>
                }
                @if (Model.HasNextPage)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageIndex + 1)">Next</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>
</body>
