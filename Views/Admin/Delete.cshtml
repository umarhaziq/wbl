@model wbl.Models.ApplicationUser

@{
    ViewData["Title"] = "Delete Admin";
}

<div class="container">

    <h4>Are you sure you want to delete this admin?</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Email
        </dt>
        <dd class="col-sm-10">
            @Model.Email
        </dd>
        <dt class="col-sm-2">
            Full Name
        </dt>
        <dd class="col-sm-10">
            @Model.FullName
        </dd>
        <!-- Display other properties as needed -->
    </dl>

    <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="ListAdmin" class="btn btn-secondary">Back to List</a>
    </form>
</div>
