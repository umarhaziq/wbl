@model ParentViewModel

@{
    ViewData["Title"] = "Parent Registration";
}

@if (TempData["Notification"] != null)
{
    <div class="alert alert-warning">
        @TempData["Notification"]
    </div>
}


<div class="row justify-content-center">
    <div class="col-lg-8 col-md-10 col-sm-12 rounded border p-4 bg-light shadow">
        <h2 class="text-center mb-4">Parent Registration Form</h2>
        <hr />
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <form asp-action="Create" method="post">
            <h4 class="mb-3">Father's Details</h4>
            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="FatherName">Full Name</label>
                        <input asp-for="FatherName" class="form-control" placeholder="Enter father's full name" />
                        <span asp-validation-for="FatherName" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="FatherEmail">Email</label>
                        <input asp-for="FatherEmail" class="form-control" placeholder="Enter father's email" />
                        <span asp-validation-for="FatherEmail" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="FatherIc">IC Number</label>
                        <input asp-for="FatherIc" class="form-control" placeholder="Enter father's IC number" />
                        <span asp-validation-for="FatherIc" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="FatherPhone">Phone Number</label>
                        <input asp-for="FatherPhone" class="form-control" placeholder="Enter father's phone number" />
                        <span asp-validation-for="FatherPhone" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-12">
                    <div class="form-group">
                        <label asp-for="FatherAddress">Address</label>
                        <input asp-for="FatherAddress" class="form-control" placeholder="Enter father's address" />
                        <span asp-validation-for="FatherAddress" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="FatherRace">Race</label>
                        <select asp-for="FatherRace" class="form-control">
                            <option value="">Select Race</option>
                            <option value="Malay">Malay</option>
                            <option value="Indian">Indian</option>
                            <option value="Chinese">Chinese</option>
                            <!-- Add more options as needed -->
                        </select>
                        <span asp-validation-for="FatherRace" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="FatherOccupation">Occupation</label>
                        <input asp-for="FatherOccupation" class="form-control" placeholder="Enter father's occupation" />
                        <span asp-validation-for="FatherOccupation" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-12">
                    <div class="form-group">
                        <label asp-for="FatherWorkAddress">Work Address</label>
                        <input asp-for="FatherWorkAddress" class="form-control" placeholder="Enter father's work address" />
                        <span asp-validation-for="FatherWorkAddress" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Option to Add Mother's Details -->
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="addMotherDetails">
                <label class="form-check-label" for="addMotherDetails">Add Mother's Details</label>
            </div>

            <!-- Mother's Details (Initially Hidden) -->
            <div id="motherDetails" style="display:none;">
                <h4 class="mb-3">Mother's Details</h4>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="MotherName">Full Name</label>
                            <input asp-for="MotherName" class="form-control" placeholder="Enter mother's full name" />
                            <span asp-validation-for="MotherName" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="MotherEmail">Email</label>
                            <input asp-for="MotherEmail" class="form-control" placeholder="Enter mother's email" />
                            <span asp-validation-for="MotherEmail" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="MotherIc">IC Number</label>
                            <input asp-for="MotherIc" class="form-control" placeholder="Enter mother's IC number" />
                            <span asp-validation-for="MotherIc" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="MotherPhone">Phone Number</label>
                            <input asp-for="MotherPhone" class="form-control" placeholder="Enter mother's phone number" />
                            <span asp-validation-for="MotherPhone" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="MotherRace">Race</label>
                            <select asp-for="MotherRace" class="form-control">
                                <option value="">Select Race</option>
                                <option value="Malay">Malay</option>
                                <option value="Indian">Indian</option>
                                <option value="Chinese">Chinese</option>
                                <!-- Add more options as needed -->
                            </select>
                            <span asp-validation-for="MotherRace" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="MotherOccupation">Occupation</label>
                            <input asp-for="MotherOccupation" class="form-control" placeholder="Enter mother's occupation" />
                            <span asp-validation-for="MotherOccupation" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-12">
                        <div class="form-group">
                            <label asp-for="MotherAddress">Address</label>
                            <input asp-for="MotherAddress" class="form-control" placeholder="Enter mother's address" />
                            <span asp-validation-for="MotherAddress" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-12">
                        <div class="form-group">
                            <label asp-for="MotherWorkAddress">Work Address</label>
                            <input asp-for="MotherWorkAddress" class="form-control" placeholder="Enter mother's work address" />
                            <span asp-validation-for="MotherWorkAddress" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Register</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('addMotherDetails').addEventListener('change', function () {
            var motherDetails = document.getElementById('motherDetails');
            if (this.checked) {
                motherDetails.style.display = 'block';
            } else {
                motherDetails.style.display = 'none';
            }
        });
    </script>
}
