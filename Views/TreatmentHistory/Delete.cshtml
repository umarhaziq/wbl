@model wbl.Models.TreatmentHistory

@{
    ViewData["Title"] = "Delete Treatment History";
}

<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-header bg-danger text-white">
            <h2 class="card-title">Delete Treatment History</h2>
        </div>
        <div class="card-body">
            <h3 class="text-danger">Are you sure you want to delete this?</h3>
            <div class="mb-3">
                <h4 class="card-subtitle mb-2 text-muted">History ID: @Model.historyId</h4>
                <div class="mb-2">
                    <label class="font-weight-bold">Pediatricians:</label>
                    <p class="form-control-plaintext">@Model.pediatricians</p>
                </div>
                <div class="mb-2">
                    <label class="font-weight-bold">Recommended Hospital/Clinic:</label>
                    <p class="form-control-plaintext">@Model.recHospClinic</p>
                </div>
                <div class="mb-2">
                    <label class="font-weight-bold">Diagnose Description:</label>
                    <p class="form-control-plaintext">@Model.diagnoseDesc</p>
                </div>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="historyId" />
                <input type="hidden" asp-for="ChildId" />
                <div class="form-group">
                    <input type="submit" value="Delete" class="btn btn-danger btn-block" />
                </div>
            </form>

            <div class="mt-3">
                <a class="btn btn-secondary btn-block" asp-action="Index" asp-route-ChildId="@Model.ChildId">Back to List</a>
            </div>
        </div>
    </div>
</div>
